# The public origin COSMOS is served from, with no trailing slash.
#
# It is used for the canonical link, the Open Graph and Twitter metadata,
# robots.txt and sitemap.xml. Nothing secret belongs in this file: every
# VITE_-prefixed value is compiled into the JavaScript that ships to the
# browser.
#
# On Vercel this is optional: without it the build uses the project's
# production domain. Set it (Settings → Environment Variables) only to
# override that. Local builds without it use localhost and print a warning.
VITE_SITE_URL=https://your-domain.example
