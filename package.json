{
  "name": "cosmos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive 3D universe: explore the solar system, galaxies, nebulae and real space missions in the browser.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "catalogue": "node scripts/build-catalogue.mjs",
